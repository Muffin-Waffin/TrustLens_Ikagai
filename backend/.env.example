# Trustlens Backend Configuration

# OpenRouter API Key for AI Chatbot Assistant
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model ID (Default: google/gemini-2.0-flash-001)
# Examples: google/gemini-2.0-flash-001, meta-llama/llama-3.3-70b-instruct, anthropic/claude-3.5-haiku, openai/gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Server Settings
HOST=0.0.0.0
PORT=8000
